# Example environment variables. Placeholders only: never put a real value here
# (this repository is public). Real values live in Vercel and in .env.local.

# Test-account cleanup (OX-1r): the second secret that unlocks the
# secret-gated cleanup database function. Read ONLY by
# lib/server/testCleanupSecret.ts. Unset = the tool is off (503).
# Production only, never Preview: preview builds run branch code from this
# public repo against the same database. The database stores only its sha256
# (runbook docs/runbooks/TEST_ACCOUNT_CLEANUP_RUNBOOK.md, section 6).
TEST_CLEANUP_SECRET=<64-hex-characters-generated-locally>

# Test harness "Test credits" tab (slice TC-1, TEST ONLY): lets an admin take
# plan credits from an account on /test-business-os. Read ONLY by
# lib/business-os/credits/testCreditToolsFlag.ts. Unset = off (the route
# answers 404). Developer .env.local only, never Vercel.
BUSINESS_OS_TEST_CREDIT_TOOLS_ENABLED=false

# Upgrade modal demo page (UM-2, TEST ONLY): /business-os/upgrade-modal-demo
# opens the plan comparison window from outside Settings. Read ONLY by
# lib/business-os/upgradeModalDemoFlag.ts. Unset = off (the page answers 404).
# Developer .env.local only, never Vercel.
BUSINESS_OS_UPGRADE_MODAL_DEMO_ENABLED=false

# Business OS customer portal (plan payments P-7a.2): the portal configuration
# (card update and invoices only; no cancel, no plan switching) of the SAME
# Stripe mode as STRIPE_SECRET_KEY. Created and checked by
# scripts/setup-bos-portal-configuration.ts (test mode by default, --live for
# production). Unset or not a bpc_ id = "Update card" refuses (503); the app
# never falls back to Stripe's default configuration. The id below is the
# standard TEST sandbox's (acct_1UPKR4C7KDUGYIcA), safe to share; never put
# the live one here.
STRIPE_BOS_PORTAL_CONFIGURATION_ID=bpc_1UUv5MC7KDUGYIcA3O6iIzRJ
