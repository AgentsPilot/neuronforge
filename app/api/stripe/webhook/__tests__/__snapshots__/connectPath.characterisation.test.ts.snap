            "status": "cancelled",
            "updated_at": "<NOW>",
          },
        ],
        [
          "eq",
          "user_id",
          "owner-a",
        ],
        [
          "eq",
          "subscription_id",
          "sub_plan_1",
        ],
        [
          "not",
          "status",
          "in",
          "(paid,cancelled)",
