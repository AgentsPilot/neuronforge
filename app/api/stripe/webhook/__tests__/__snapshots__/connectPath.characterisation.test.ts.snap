    {
      "chain": [
        [
          "select",
          "user_id, client_email, client_name, invoice_number, currency, booking_id",
        ],
        [
          "eq",
          "id",
          "pinv-0001",
        ],
      ],
      "operation": "select",
      "table": "payment_invoices",
      "terminal": "maybeSingle",
      "type": "db",
    },
    {
      "chain": [
