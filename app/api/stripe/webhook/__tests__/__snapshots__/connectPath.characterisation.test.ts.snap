      ],
      "operation": "update",
      "table": "scheduling_bookings",
      "terminal": "await",
      "type": "db",
    },
    {
      "args": [
        {
          "action": "INVOICE_PAID",
          "details": {
            "amount": 150,
            "connect_account_id": "acct_owner_a",
            "currency": "usd",
            "stripe_invoice_id": "in_connect_1",
