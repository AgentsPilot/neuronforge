exports[`Stripe webhook, Connect path characterisation (P-0 baseline) 1a. invoice.paid, platform invoice found by stripe_invoice_id, owned, booking linked 1`] = `
{
  "body": {
    "received": true,
  },
  "effects": [
    {
      "secret": "whsec_platform_test",
      "type": "stripe.constructWebhookEvent",
    },
    {
      "chain": [
        [
          "select",
          "event_id, status",
        ],
        [
          "eq",
          "event_id",
          "evt_connect_invoice_paid",
        ],
      ],
      "operation": "select",
      "table": "processed_webhook_events",
      "terminal": "maybeSingle",
      "type": "db",
    },
    {
      "chain": [
        [
          "insert",
          {
            "event_id": "evt_connect_invoice_paid",
            "event_type": "invoice.paid",
            "metadata": {
              "created": 1790000000,
              "livemode": false,
            },
            "processed_at": "<NOW>",
            "status": "processing",
          },
        ],
      ],
      "operation": "insert",
      "table": "processed_webhook_events",
      "terminal": "await",
      "type": "db",
    },
    {
      "chain": [
        [
          "select",
          "*",
        ],
        [
          "eq",
          "stripe_invoice_id",
          "in_connect_1",
        ],
      ],
      "operation": "select",
      "table": "payment_invoices",
      "terminal": "single",
      "type": "db",
    },
    {
      "args": [
        "<supabase-admin>",
        "acct_owner_a",
      ],
      "type": "resolveAccountOwner",
    },
    {
