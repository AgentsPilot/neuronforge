        ],
        "owner-a",
      ],
      "type": "syncBookingsForTransactions",
    },
    {
      "chain": [
        [
          "update",
          {
            "completed_at": "<NOW>",
            "status": "completed",
          },
        ],
        [
          "eq",
          "event_id",
          "evt_connect_charge_refunded",
