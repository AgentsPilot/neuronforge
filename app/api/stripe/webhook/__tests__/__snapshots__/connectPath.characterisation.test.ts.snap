    },
    {
      "args": [
        {
          "account": "acct_owner_a",
          "paymentIntentId": "pi_invoice_1",
          "stripe": "<stripe-client>",
        },
      ],
      "type": "resolveProcessorFee",
    },
    {
      "chain": [
        [
          "insert",
          {
