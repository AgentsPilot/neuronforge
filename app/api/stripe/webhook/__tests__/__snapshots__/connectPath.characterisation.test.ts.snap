          {
            "completed_at": "<NOW>",
            "status": "completed",
          },
        ],
        [
          "eq",
          "event_id",
          "evt_connect_subscription_deleted",
        ],
      ],
      "operation": "update",
      "table": "processed_webhook_events",
      "terminal": "await",
      "type": "db",
    },
