# Shell scripts run on Linux CI (GitHub Actions, Vercel build containers).
# CRLF would make bash fail with ": command not found".
*.sh text eol=lf

# Workflows embed bash directly in `run:` blocks, so they need the same
# protection as a .sh file - the rule above does not reach them by extension.
.github/workflows/*.yml text eol=lf

# Operator SQL generated by scripts/generate-test-account-cleanup-sql.ts. Its drift
# test compares byte for byte, and the generator writes LF.
scripts/test-account-cleanup-*.sql text eol=lf

# The generated cleanup function migrations and their rollbacks (every version).
# The drift test and the applied sha256 pins read them as LF.
supabase/migrations/*_operator_test_account_cleanup*.sql text eol=lf
supabase/SQL[[:space:]]Scripts/*_operator_test_account_cleanup*_rollback.sql text eol=lf
