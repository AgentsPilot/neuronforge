{
  "crons": [
    {
      "path": "/api/run-scheduled-agents",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/auth/cleanup-incomplete",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/update-template-scores",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/memory-consolidation",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/cron/calendar-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/insight-metrics",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/insight-detect",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/insight-automations",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/payment-retry",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<subdomain>[^.]+)\\.agentpilot\\.io"
        }
      ],
      "destination": "/site/:subdomain/:path*"
    }
  ]
}